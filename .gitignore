# =======================================================================
# Python (FastAPI / ai-chatbot backend)
# =======================================================================
# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# Virtual environments (standard + common aliases)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.venv.bak/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django / Flask / FastAPI migrations (already tracked in Rails schema.rb, not here)

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Celery beat schedule
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments / dotenv (extra safety in case root rule is removed)
.python-version
.venv

# PyCharm / VSCode (Python-specific; JetBrains already covered below)
# __pycache__ pattern is recursive so covers backend/ai-chatbot/app/__pycache__ automatically

# HuggingFace / SentenceTransformers / PyTorch caches
.huggingface/
.cache/huggingface/
.cache/torch/
.cache/torch_extensions/
.cache/transformers/
.cache/sentence_transformers/
torch_cache/

# mypy / static analysis
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
.pyre/
.pyre/
.pyright/
*.pyre

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pipenv / pdm / poetry
Pipfile.lock
poetry.lock
pdm.lock
.pdm-python

